# Web3Forms Access Key
# 1. Sign in at https://web3forms.com and get your access key from the dashboard.
# 2. The access key determines which email address receives form submissions.
#    Confirm the recipient address in your Web3Forms account settings before going live.
# 3. Copy this file to .env.local and fill in the real value.
#    .env.local is excluded from Git — never commit the real key.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your_access_key_here

# Phone and WhatsApp contact number (Israeli format, e.g. 050-1234567)
# Leave empty to hide contact links until a real number is available.
# See README.md for instructions.
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_WHATSAPP=
